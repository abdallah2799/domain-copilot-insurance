# Copy to .env and fill in. Never commit the real .env file.

# ---- LLM providers (provider abstraction: hosted primary, local fallback) ----
# Fallback order (OpenAI -> Ollama) is fixed by design, not configurable here — see the
# provider-abstraction ADR. Double-underscore names map to appsettings.json's Providers:* section
# via ASP.NET Core's standard environment-variable configuration binding.
Providers__OpenAi__ApiKey=
Providers__OpenAi__Model=gpt-4o-mini
Providers__OpenAi__EmbeddingModel=text-embedding-3-small

Providers__Ollama__BaseUrl=http://ollama:11434
Providers__Ollama__Model=llama3.1
Providers__Ollama__EmbeddingModel=nomic-embed-text

# ---- Relational store ----
MSSQL_SA_PASSWORD=ChangeMe_LocalDevOnly!
SQL_CONNECTION_STRING=Server=mssql,1433;Database=DomainCopilot;User Id=sa;Password=ChangeMe_LocalDevOnly!;TrustServerCertificate=True

# ---- Vector store ----
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---- Auth ----
JWT_SIGNING_KEY=ChangeMe_Generate_A_Real_Secret_Locally
JWT_ISSUER=domain-copilot
JWT_AUDIENCE=domain-copilot-clients

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
