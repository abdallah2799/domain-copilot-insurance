# Copy to .env and fill in. Never commit the real .env file.

# ---- LLM providers (provider abstraction: hosted + local fallback) ----
LLM_PRIMARY_PROVIDER=OpenAI
LLM_FALLBACK_PROVIDER=Ollama

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Relational store ----
MSSQL_SA_PASSWORD=ChangeMe_LocalDevOnly!
SQL_CONNECTION_STRING=Server=mssql,1433;Database=DomainCopilot;User Id=sa;Password=ChangeMe_LocalDevOnly!;TrustServerCertificate=True

# ---- Vector store ----
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---- Auth ----
JWT_SIGNING_KEY=ChangeMe_Generate_A_Real_Secret_Locally
JWT_ISSUER=domain-copilot
JWT_AUDIENCE=domain-copilot-clients

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
