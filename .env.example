# Copy to .env and fill in. Never commit the real .env file.

# ---- LLM providers (provider abstraction) ----
# Fallback order is fixed by design, not configurable here — see ADR-0003.
# Completions: OpenRouter (hosted, free-tier model) -> Ollama (local). OpenRouter's free tier is
# rate-limited (20 req/min, 50 req/day without a credit purchase; 1000/day with $10+ lifetime
# credits) — get a key at https://openrouter.ai/keys.
# Embeddings: Ollama (local) -> OpenAI (hosted fallback only; OpenRouter has no embeddings API).
# Double-underscore names map to appsettings.json's Providers:* section via ASP.NET Core's
# standard environment-variable configuration binding.
Providers__OpenRouter__ApiKey=
Providers__OpenRouter__Model=nvidia/nemotron-3.5-lightning:free
Providers__OpenRouter__BaseUrl=https://openrouter.ai/api/v1

Providers__Ollama__BaseUrl=http://ollama:11434
Providers__Ollama__Model=llama3.1
Providers__Ollama__EmbeddingModel=nomic-embed-text

# Only used as the embeddings fallback if Ollama is unavailable — not required to get started.
Providers__OpenAi__ApiKey=
Providers__OpenAi__Model=gpt-4o-mini
Providers__OpenAi__EmbeddingModel=text-embedding-3-small

# ---- Relational store ----
MSSQL_SA_PASSWORD=ChangeMe_LocalDevOnly!
SQL_CONNECTION_STRING=Server=mssql,1433;Database=DomainCopilot;User Id=sa;Password=ChangeMe_LocalDevOnly!;TrustServerCertificate=True

# ---- Vector store ----
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---- Auth ----
JWT_SIGNING_KEY=ChangeMe_Generate_A_Real_Secret_Locally
JWT_ISSUER=domain-copilot
JWT_AUDIENCE=domain-copilot-clients

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
