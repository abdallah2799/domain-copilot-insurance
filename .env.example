# Copy to .env and fill in. Never commit the real .env file.

# ---- LLM providers (provider abstraction) ----
# Fallback order is fixed by design, not configurable here — see ADR-0003.
# Completions: OpenRouter (hosted, free-tier model) -> Ollama (local). OpenRouter's free tier is
# rate-limited (20 req/min, 50 req/day without a credit purchase; 1000/day with $10+ lifetime
# credits) — get a key at https://openrouter.ai/keys.
# Embeddings: Ollama (local) -> OpenAI (hosted fallback only; OpenRouter has no embeddings API).
# Double-underscore names map to appsettings.json's Providers:* section via ASP.NET Core's
# standard environment-variable configuration binding.
Providers__OpenRouter__ApiKey=
Providers__OpenRouter__Model=nvidia/nemotron-3.5-lightning:free
Providers__OpenRouter__BaseUrl=https://openrouter.ai/api/v1

Providers__Ollama__BaseUrl=http://ollama:11434
Providers__Ollama__Model=llama3.1
Providers__Ollama__EmbeddingModel=nomic-embed-text

# Only used as the embeddings fallback if Ollama is unavailable — not required to get started.
Providers__OpenAi__ApiKey=
Providers__OpenAi__Model=gpt-4o-mini
Providers__OpenAi__EmbeddingModel=text-embedding-3-small

# ---- Relational store ----
# "mssql,1433" is the docker-compose network hostname — correct once the API itself also runs in
# compose. Running `dotnet run` directly on the host instead (current dev setup, no Api Dockerfile
# yet) needs "localhost,14330" (the host-mapped port in docker-compose.yml) here instead.
MSSQL_SA_PASSWORD=ChangeMe_LocalDevOnly!
ConnectionStrings__Default=Server=mssql,1433;Database=DomainCopilot;User Id=sa;Password=ChangeMe_LocalDevOnly!;TrustServerCertificate=True

# ---- Vector store ----
# Qdrant's .NET client speaks gRPC (port 6334), not the REST API (6333) curl/a browser would hit —
# host+port, not a URL, specifically to avoid that mix-up. "qdrant" is the docker-compose network
# hostname; host-based `dotnet run` (current dev setup) needs "localhost" instead.
VectorStore__Qdrant__Host=qdrant
VectorStore__Qdrant__GrpcPort=6334
VectorStore__Qdrant__Https=false
VectorStore__Qdrant__ApiKey=

# ---- Auth (ADR-0012) ----
# Generate a real random value locally (e.g. `openssl rand -base64 48`) -- never reuse this example.
JWT_SIGNING_KEY=ChangeMe_Generate_A_Real_Secret_Locally
JWT_ISSUER=domain-copilot
JWT_AUDIENCE=domain-copilot-clients
JWT_EXPIRY_MINUTES=480

# The two demo accounts (one per FR-8 role) DemoUserSeeder creates on first startup against an
# empty Users table -- there is no self-service registration (see ADR-0012 for why). Leaving either
# password blank skips seeding entirely rather than creating an account with a known-empty password.
SEED_ADJUSTER_USERNAME=adjuster
SEED_ADJUSTER_PASSWORD=
SEED_ANALYST_USERNAME=analyst
SEED_ANALYST_PASSWORD=

# ---- Observability (ADR-0013) ----
# "otel-collector" is the docker-compose network hostname for the self-hosted .NET Aspire Dashboard
# (accepts OTLP directly, no separate collector needed). Running the API via `dotnet run` directly
# on a host instead needs "localhost:4317" here, matching the MSSQL/Qdrant host-vs-container split
# above. Dashboard UI: http://localhost:18888.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Optional: illustrative published list prices for the one paid provider this project's fallback
# chain can reach (OpenAI) -- every provider actually used in verification (Ollama, OpenRouter's
# free-tier model) prices at $0 by design (ModelPricingOptions), not because this is unimplemented.

# ---- OCR (T6) ----
# Defaults (tesseract/pdftoppm resolved via PATH, Tesseract finding its own bundled tessdata) are
# correct for a normal `apt install tesseract-ocr poppler-utils` and for CI. Only set
# Ocr__TesseractLibraryPath / Ocr__TessDataPrefix if Tesseract was installed somewhere
# non-standard (e.g. extracted from its .deb into a user-local prefix on a machine with no root).
Ocr__TesseractBinaryPath=tesseract
Ocr__TesseractLibraryPath=
Ocr__TessDataPrefix=
Ocr__PdftoppmBinaryPath=pdftoppm
